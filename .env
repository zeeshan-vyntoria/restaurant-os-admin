# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:5000/api
# true = use in-browser mock data, false = call the real backend
VITE_USE_MOCKS=false
# true = use local read-only demo data when a GET endpoint returns 404
VITE_FALLBACK_TO_MOCKS=false
# Soniox TTS voice for the kitchen voice agent (name from the Soniox console, or a cloned-voice id)
VITE_SONIOX_TTS_VOICE=Adrian
